{
  "name": "hub-ia",
  "productName": "Hub IA",
  "version": "0.1.0-alpha.7",
  "private": true,
  "description": "Hub local pour piloter plusieurs IA (Claude Code, Ollama...) depuis un seul endroit",
  "author": "Hub IA",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node build.mjs && electron .",
    "selftest": "node build.mjs && node dist/selftest.js",
    "smoke": "node build.mjs && electron . --smoke",
    "test:image": "esbuild scripts/test-image.ts --bundle --platform=node --format=cjs --outfile=dist/test-image.js --external:7zip-bin --log-level=warning && node dist/test-image.js",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "node build.mjs && electron-builder --win nsis portable --publish never",
    "dist:portable": "node build.mjs && electron-builder --win portable --publish never",
    "dist:setup": "node build.mjs && electron-builder --win nsis --publish never",
    "release:assets": "node scripts/release-assets.mjs"
  },
  "build": {
    "appId": "local.hubia.app",
    "productName": "Hub IA",
    "copyright": "Hub IA",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main.js",
      "dist/preload.js",
      "dist/icon.png",
      "dist/renderer/**",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hub IA",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Hub-IA-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Hub-IA-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "totoFR6974",
      "repo": "DASHBOARD-IA",
      "releaseType": "prerelease"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^26.6.11",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.8.11"
  }
}
